# Same API, exposed to the browser ONLY for the live notification stream (Server-Sent Events).
# The API's CORS_ORIGINS must include this dashboard's origin.
NEXT_PUBLIC_API_URL=https://swfpv-summit-api.onrender.com

# Shown in the UI
NEXT_PUBLIC_APP_NAME=Summit Console
NEXT_PUBLIC_EVENT_NAME=Southwest Regional Stakeholder Summit
